<Window x:Class="UrevoSpacewalkCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urevo Spacewalk Commander" Width="560" Height="960" MinWidth="480" MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="BigButton" TargetType="Button">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style x:Key="StepButton" TargetType="Button">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="Gray" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SettingValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Header="Connection">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" Margin="4" VerticalContentAlignment="Center"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberPath="DisplayName" />
          <Button Grid.Column="1" Content="Scan" Command="{Binding ScanCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="Connect" Command="{Binding ConnectCommand}" />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
        <TextBlock Margin="4,2" Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="Control">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource BigButton}" Content="Start"
                  Command="{Binding StartCommand}" Background="#FFB7E4B8" />
          <Button Grid.Column="1" Style="{StaticResource BigButton}" Content="Pause"
                  Command="{Binding PauseCommand}" Background="#FFFFE29A" />
          <Button Grid.Column="2" Style="{StaticResource BigButton}" Content="STOP"
                  Command="{Binding StopCommand}" Background="#FFF2A5A5" />
        </Grid>

        <TextBlock Margin="4,12,4,0" Text="Speed" Style="{StaticResource ValueLabel}" />
        <TextBlock Margin="4,0" Style="{StaticResource SettingValue}"
                   Text="{Binding TargetSpeed, StringFormat={}{0:0.0} km/h}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource StepButton}" Content="&#x2212;"
                  Command="{Binding SpeedDownCommand}" />
          <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                  Minimum="{Binding MinSpeed}" Maximum="{Binding MaxSpeed}"
                  TickFrequency="{Binding SpeedStep}" IsSnapToTickEnabled="True"
                  IsEnabled="{Binding IsConnected}"
                  Value="{Binding TargetSpeed, Mode=TwoWay}" />
          <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="+"
                  Command="{Binding SpeedUpCommand}" />
        </Grid>

        <TextBlock Margin="4,14,4,0" Text="Incline" Style="{StaticResource ValueLabel}" />
        <TextBlock Margin="4,0" Style="{StaticResource SettingValue}"
                   Text="{Binding TargetIncline, StringFormat={}{0:0.#} %}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource StepButton}" Content="&#x2212;"
                  Command="{Binding InclineDownCommand}" />
          <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                  Minimum="{Binding MinIncline}" Maximum="{Binding MaxIncline}"
                  TickFrequency="{Binding InclineStep}" IsSnapToTickEnabled="True"
                  IsEnabled="{Binding IsConnected}"
                  Value="{Binding TargetIncline, Mode=TwoWay}" />
          <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="+"
                  Command="{Binding InclineUpCommand}" />
        </Grid>

        <TextBlock Margin="4,10,4,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="The speed is applied on start and adjusted immediately while the belt is running." />
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="2" Header="Live values from the treadmill">
      <UniformGrid Columns="3" Rows="2">
        <StackPanel Margin="4">
          <TextBlock Text="Speed" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding CurrentSpeedText}" Style="{StaticResource ValueText}" />
        </StackPanel>
        <StackPanel Margin="4">
          <TextBlock Text="Incline" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding CurrentInclineText}" Style="{StaticResource ValueText}" />
        </StackPanel>
        <StackPanel Margin="4">
          <TextBlock Text="Distance" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding DistanceText}" Style="{StaticResource ValueText}" />
        </StackPanel>
        <StackPanel Margin="4">
          <TextBlock Text="Time" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource ValueText}" />
        </StackPanel>
        <StackPanel Margin="4">
          <TextBlock Text="Energy" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding EnergyText}" Style="{StaticResource ValueText}" />
        </StackPanel>
        <StackPanel Margin="4">
          <TextBlock Text="Heart rate" Style="{StaticResource ValueLabel}" />
          <TextBlock Text="{Binding HeartRateText}" Style="{StaticResource ValueText}" />
        </StackPanel>
      </UniformGrid>
    </GroupBox>

    <GroupBox Grid.Row="3" Header="Google Health" DataContext="{Binding WorkoutSync}">
      <StackPanel>
        <TextBlock Margin="4,2" Text="{Binding StatusText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
          <Button Content="Sign in with Google" Command="{Binding SignInCommand}" />
          <Button Content="Upload pending" Command="{Binding UploadPendingCommand}" />
          <Button Content="Open settings" Command="{Binding OpenSettingsFolderCommand}" />
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="4" Header="Log" Margin="0">
      <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </GroupBox>
  </Grid>
</Window>
