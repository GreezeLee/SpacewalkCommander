<Window x:Class="UrevoSpacewalkCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urevo Spacewalk Commander" Width="600" Height="980" MinWidth="540" MinHeight="860"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <Window.Resources>
    <!-- Slope symbol for the incline (no suitable glyph in the icon font). -->
    <Geometry x:Key="InclineGeometry">M0,10 L12,10 L12,1 Z</Geometry>

    <!-- Speedometer symbol: gauge arc with a needle; drawn with a stroke. -->
    <Geometry x:Key="SpeedGeometry">M1,11 A7,7 0 1 1 15,11 M8,11 L11.5,5.5</Geometry>

    <Style x:Key="SpeedIcon" TargetType="Path">
      <Setter Property="Data" Value="{StaticResource SpeedGeometry}" />
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card heading: coloured icon followed by an upper-case caption. -->
    <Style x:Key="CardHeader" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TargetValue" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="RangeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--
      Connection state badge in the header. The state is derived from the view model flags; later triggers win, so
      "Running" beats "Connected". Searching and running pulse.
    -->
    <ControlTemplate x:Key="StatusPillTemplate" TargetType="ContentControl">
      <ControlTemplate.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever">
          <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                           From="0.6" To="0" Duration="0:0:1.4" />
          <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX"
                           From="1" To="2.8" Duration="0:0:1.4" />
          <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY"
                           From="1" To="2.8" Duration="0:0:1.4" />
        </Storyboard>
      </ControlTemplate.Resources>
      <Border x:Name="Pill" CornerRadius="15" Padding="12,7" Background="#14FFFFFF">
        <StackPanel Orientation="Horizontal">
          <Grid Width="9" Height="9" VerticalAlignment="Center">
            <Ellipse x:Name="Halo" Fill="{StaticResource TextSubtleBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot" Fill="{StaticResource TextSubtleBrush}" />
          </Grid>
          <TextBlock x:Name="Label" Margin="8,0,0,0" Text="Offline" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsScanning}" Value="True">
          <Setter TargetName="Pill" Property="Background" Value="#1FF59E0B" />
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PauseBrush}" />
          <Setter TargetName="Halo" Property="Fill" Value="{StaticResource PauseBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PauseBrush}" />
          <Setter TargetName="Label" Property="Text" Value="Searching" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="ScanPulse" Storyboard="{StaticResource Pulse}" />
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="ScanPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
          <Setter TargetName="Pill" Property="Background" Value="#1FF59E0B" />
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PauseBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PauseBrush}" />
          <Setter TargetName="Label" Property="Text" Value="Connecting" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsConnected}" Value="True">
          <Setter TargetName="Pill" Property="Background" Value="#1F2DD4BF" />
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Label" Property="Text" Value="Connected" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRunning}" Value="True">
          <Setter TargetName="Pill" Property="Background" Value="#1F22C55E" />
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GoBrush}" />
          <Setter TargetName="Halo" Property="Fill" Value="{StaticResource GoBrush}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GoBrush}" />
          <Setter TargetName="Label" Property="Text" Value="Running" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="RunPulse" Storyboard="{StaticResource Pulse}" />
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="RunPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Window.Resources>

  <Grid Margin="20,14,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="110" />
    </Grid.RowDefinitions>

    <!-- ================================================================================= Header -->
    <Grid Grid.Row="0" Margin="2,0,2,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentGradientBrush}">
        <Path Style="{StaticResource SpeedIcon}" Width="22" StrokeThickness="2.4"
              Stroke="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
        <TextBlock Text="Spacewalk Commander" Style="{StaticResource TitleText}" />
        <TextBlock Margin="0,1,0,0" Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="12.5" />
      </StackPanel>
      <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False"
                      Template="{StaticResource StatusPillTemplate}" />
    </Grid>

    <!-- ================================================================================= Connection -->
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Margin="8,0,0,0" Text="Treadmill" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                    ToolTip="{Binding SelectedDevice.DisplayName}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" FontSize="12" Margin="0,0,8,0"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Command="{Binding ScanCommand}"
                  ToolTip="Search for Bluetooth treadmills nearby (20 s)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="0,0,7,0" />
              <TextBlock Text="Scan" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,0" Style="{StaticResource PrimaryButton}"
                  Command="{Binding ConnectCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" Margin="0,0,7,0" />
              <TextBlock Text="Connect" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Margin="8,0,0,0" Padding="12,0" Content="Disconnect"
                  Command="{Binding DisconnectCommand}" ToolTip="Stops a running belt first" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- ================================================================================= Control -->
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Target speed -->
          <StackPanel Grid.Column="0">
            <StackPanel Style="{StaticResource CardHeader}" Margin="0">
              <Path Style="{StaticResource SpeedIcon}" />
              <TextBlock Margin="8,0,0,0" Text="Target speed" Style="{StaticResource CaptionText}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Grid Margin="0,10,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource StepButton}" Content="&#xE738;" Command="{Binding SpeedDownCommand}"
                      ToolTip="Slower" />
              <TextBlock Grid.Column="1" Style="{StaticResource TargetValue}">
                <Run FontSize="38" FontWeight="SemiBold"
                     Text="{Binding TargetSpeed, Mode=OneWay, StringFormat={}{0:0.0}}" />
                <Run FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="km/h" />
              </TextBlock>
              <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="&#xE710;"
                      Command="{Binding SpeedUpCommand}" ToolTip="Faster" />
            </Grid>
            <Slider Minimum="{Binding MinSpeed}" Maximum="{Binding MaxSpeed}"
                    TickFrequency="{Binding SpeedStep}" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsConnected}" Foreground="{StaticResource AccentBrush}"
                    Value="{Binding TargetSpeed, Mode=TwoWay}" />
            <Grid Margin="2,0">
              <TextBlock Style="{StaticResource RangeText}" Text="{Binding MinSpeed, StringFormat={}{0:0.0}}" />
              <TextBlock Style="{StaticResource RangeText}" HorizontalAlignment="Right"
                         Text="{Binding MaxSpeed, StringFormat={}{0:0.0}}" />
            </Grid>
          </StackPanel>

          <!-- Target incline -->
          <StackPanel Grid.Column="2">
            <StackPanel Style="{StaticResource CardHeader}" Margin="0">
              <Path Data="{StaticResource InclineGeometry}" Fill="{StaticResource InclineBrush}" Width="13"
                    Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Margin="8,0,0,0" Text="Target incline" Style="{StaticResource CaptionText}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Grid Margin="0,10,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource StepButton}" Content="&#xE738;" Command="{Binding InclineDownCommand}"
                      ToolTip="Flatter" />
              <TextBlock Grid.Column="1" Style="{StaticResource TargetValue}">
                <Run FontSize="38" FontWeight="SemiBold"
                     Text="{Binding TargetIncline, Mode=OneWay, StringFormat={}{0:0.#}}" />
                <Run FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="%" />
              </TextBlock>
              <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="&#xE710;"
                      Command="{Binding InclineUpCommand}" ToolTip="Steeper" />
            </Grid>
            <Slider Minimum="{Binding MinIncline}" Maximum="{Binding MaxIncline}"
                    TickFrequency="{Binding InclineStep}" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsConnected}" Foreground="{StaticResource InclineBrush}"
                    Value="{Binding TargetIncline, Mode=TwoWay}" />
            <Grid Margin="2,0">
              <TextBlock Style="{StaticResource RangeText}" Text="{Binding MinIncline, StringFormat={}{0:0.#} %}" />
              <TextBlock Style="{StaticResource RangeText}" HorizontalAlignment="Right"
                         Text="{Binding MaxIncline, StringFormat={}{0:0.#} %}" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- Start / Pause / Stop -->
        <Grid Margin="-5,18,-5,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource StartButton}" Command="{Binding StartCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="16" Margin="0,0,10,0" />
              <TextBlock Text="Start" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource PauseButton}" Command="{Binding PauseCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE769;" FontSize="16" Margin="0,0,10,0" />
              <TextBlock Text="Pause" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource StopButton}" Command="{Binding StopCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" FontSize="16" Margin="0,0,10,0" />
              <TextBlock Text="STOP" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock Margin="2,14,0,0" Style="{StaticResource MutedText}" Foreground="{StaticResource TextSubtleBrush}"
                   Text="The speed is applied on start and adjusted immediately while the belt is running." />
      </StackPanel>
    </Border>

    <!-- ================================================================================= Live values -->
    <Border Grid.Row="3" Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,8">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Margin="8,0,0,0" Text="Live from the treadmill" Style="{StaticResource CaptionText}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <UniformGrid Columns="3" Rows="2" Margin="-4">
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SpeedIcon}" Width="12" StrokeThickness="1.6" />
                <TextBlock Margin="6,0,0,0" Text="Speed" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CurrentSpeedText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource InclineGeometry}" Fill="{StaticResource InclineBrush}" Width="11"
                      Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Margin="6,0,0,0" Text="Incline" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CurrentInclineText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE707;" FontSize="12"
                           Foreground="#FF38BDF8" />
                <TextBlock Margin="6,0,0,0" Text="Distance" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding DistanceText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE916;" FontSize="12"
                           Foreground="#FFE2E8F0" />
                <TextBlock Margin="6,0,0,0" Text="Time" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ElapsedText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" FontSize="12"
                           Foreground="{StaticResource PauseBrush}" />
                <TextBlock Margin="6,0,0,0" Text="Energy" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding EnergyText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xEB52;" FontSize="12"
                           Foreground="#FFF43F5E" />
                <TextBlock Margin="6,0,0,0" Text="Heart rate" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <TextBlock Style="{StaticResource MetricValue}" Text="{Binding HeartRateText}" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- ================================================================================= Google Health -->
    <Border Grid.Row="4" Style="{StaticResource Card}" DataContext="{Binding WorkoutSync}">
      <StackPanel>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,6">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE753;" Foreground="#FF38BDF8" />
          <TextBlock Margin="8,0,0,0" Text="Google Health" Style="{StaticResource CaptionText}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Margin="2,0,0,12" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" />
        <UniformGrid Columns="3" Margin="-4,0">
          <Button Margin="4,0" Padding="6,0" Content="Sign in with Google" Command="{Binding SignInCommand}" />
          <Button Margin="4,0" Padding="6,0" Content="Upload pending" Command="{Binding UploadPendingCommand}" />
          <Button Margin="4,0" Padding="6,0" Content="Open settings" Command="{Binding OpenSettingsFolderCommand}"
                  ToolTip="Open the folder with settings.json and the Google OAuth client file" />
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- ================================================================================= Log -->
    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0" Padding="18,14,10,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource CardHeader}" Margin="0,0,0,6">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE81C;" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Margin="8,0,0,0" Text="Log" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox x:Name="LogList" Grid.Row="1" Margin="-8,0,0,0" Style="{StaticResource LogList}"
                 ItemsSource="{Binding LogEntries}">
          <ListBox.Resources>
            <!-- The corner between both scroll bars uses this system brush; keep it invisible. -->
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
          </ListBox.Resources>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
