<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SpacewalkCommander</RootNamespace>
    <AssemblyName>SpacewalkCommander</AssemblyName>
    <!-- The test project lives below this folder and must not be compiled into the application. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);SpacewalkCommander.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpacewalkCommander.Tests" />
  </ItemGroup>

</Project>
