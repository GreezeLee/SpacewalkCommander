{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Build the WPF application",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SpacewalkCommander.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "start",
      "detail": "Build and start the WPF application",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/SpacewalkCommander.csproj"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
